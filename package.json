{
  "name": "outward",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Small outdoor missions, matched by open AI on your device.",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build && node scripts/precache.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:model": "node scripts/smoke-model.mjs",
    "typecheck": "tsc -b --pretty false",
    "check": "npm run typecheck && npm test && npm run build",
    "test:wasm": "node scripts/smoke-wasm.mjs",
    "test:model-filters": "node scripts/smoke-model-filters.mjs"
  },
  "dependencies": {
    "@fontsource/dm-sans": "^5.2.6",
    "@fontsource/instrument-serif": "^5.2.5",
    "@huggingface/transformers": "4.3.0",
    "lucide-react": "^0.577.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^30.1.2",
    "typescript": "^5.9.3",
    "vite": "8.3.2",
    "vitest": "^4.0.0"
  }
}
